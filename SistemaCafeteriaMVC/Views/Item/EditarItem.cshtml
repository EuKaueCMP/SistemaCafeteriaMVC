<!DOCTYPE>
<html>
    <head>
        <meta charset="utf-8" />
        <title>Editar Item</title>
        <link rel="stylesheet" href="~/css/site.css" />
        <script src="~/js/site.js"></script>
    </head>
    <body>
        <h1>Editar Item</h1>
        <form asp-action="EditarItem" asp-controller="Item" method="post">
            <input type="hidden" name="itemId" value="@Model.ItemId" />
            <div>
                <label for="nome">Nome:</label>
                <input type="text" id="nome" name="nome" value="@Model.Nome" required />
            </div>
            <div>
                <label for="descricao">Descrição:</label>
                <input type="text" id="descricao" name="descricao" value="@Model.Descricao" required />
            </div>
            <div>
                <label for="preco">Preço:</label>
                <input type="number" step="0.01" id="preco" name="preco" value="@Model.Preco.ToString("F2")" required />
            </div>
            <button type="submit">Salvar Alterações</button>
            <p>@ViewBag.Erro</p>
        </form>
        </body>
</html>